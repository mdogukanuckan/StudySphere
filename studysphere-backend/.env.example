# Local gelistirme icin (docker-compose) asagidaki 5 satiri kullanin.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DATABASE=studysphere_db

# Canli ortam (Render/Neon) icin DATABASE_URL tanimlanirsa yukaridaki 5
# satir yok sayilir, tek bagli parca connection string + SSL kullanilir.
# Neon panelinden alinan "Connection string"i buraya yapistirin
# (ornek: postgresql://user:pass@ep-xxx.neon.tech/studysphere_db?sslmode=require)
# DATABASE_URL=

JWT_SECRET=replace_with_a_long_random_secret
PGADMIN_DEFAULT_EMAIL=admin@studysphere.com
PGADMIN_DEFAULT_PASSWORD=changeme

# E-posta dogrulama (OTP) icin SMTP ayarlari.
# Gmail kullanacaksaniz: Google hesabinizda 2FA'yi acip bir "Uygulama Sifresi"
# (App Password) olusturun, normal Gmail sifrenizi DEGIL bu sifreyi kullanin.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=your_email@gmail.com

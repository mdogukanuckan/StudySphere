DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DATABASE=studysphere_db

JWT_SECRET=replace_with_a_long_random_secret
PGADMIN_DEFAULT_EMAIL=admin@studysphere.com
PGADMIN_DEFAULT_PASSWORD=changeme

# E-posta dogrulama (OTP) icin SMTP ayarlari.
# Gmail kullanacaksaniz: Google hesabinizda 2FA'yi acip bir "Uygulama Sifresi"
# (App Password) olusturun, normal Gmail sifrenizi DEGIL bu sifreyi kullanin.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=your_email@gmail.com

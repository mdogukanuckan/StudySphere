# Local gelistirme icin (docker-compose) asagidaki 5 satiri kullanin.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DATABASE=studysphere_db

# Canli ortam (Render/Neon) icin DATABASE_URL tanimlanirsa yukaridaki 5
# satir yok sayilir, tek bagli parca connection string + SSL kullanilir.
# Neon panelinden alinan "Connection string"i buraya yapistirin
# (ornek: postgresql://user:pass@ep-xxx.neon.tech/studysphere_db?sslmode=require)
# DATABASE_URL=

JWT_SECRET=replace_with_a_long_random_secret
PGADMIN_DEFAULT_EMAIL=admin@studysphere.com
PGADMIN_DEFAULT_PASSWORD=changeme

# E-posta gonderimi (dogrulama kodu, sifre sifirlama, bildirimler vb.) icin
# Brevo transactional e-posta API'si kullaniliyor (SMTP degil, HTTPS).
# Brevo panelinden (Settings > SMTP & API > API Keys) bir API key olusturun.
BREVO_API_KEY=your_brevo_api_key
# Brevo'da dogrulanmis (Senders sayfasinda onaylanmis) bir gonderen adresi olmali.
MAIL_FROM=your_verified_sender@example.com

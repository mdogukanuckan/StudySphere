{
  "expo": {
    "name": "studysphere-mobile",
    "slug": "studysphere-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#112E69",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.duckan.studyspheremobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#112E69"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e1c77e01-5df9-4a7a-a0d4-185efa71b404"
      }
    },
    "owner": "duckan"
  }
}
